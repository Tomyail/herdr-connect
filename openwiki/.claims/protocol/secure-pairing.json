    {
      "id": "claim_fcf7abc9825c4254bdf60f8d43569a2a",
      "statement": "Pairing data lives in paired_devices and pairing_secrets tables (token_hash and secret_hash stored as SHA-256 BLOBs, secrets carry created/expires/consumed timestamps and a device link), separate from the schema v1 devices/device_cursors tables reserved for the future HPKE relay milestone.",
