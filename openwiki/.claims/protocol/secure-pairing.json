    {
      "id": "claim_3ab9587e91234bbd932e1350b7a376d2",
      "statement": "The future E2EE protocol (packages/protocol, mirrored in Go at protocol/protocol.go) uses the single cipher suite HPKE-X25519-HKDF-SHA256-CHACHA20POLY1305+Ed25519 with per-message HPKE encryption, Ed25519 signatures over a domain-separated envelope, event-sequence replay protection, TTL enforcement, a 256 KiB max plaintext, and structured error codes — but it is not integrated into the LAN transport.",
      "evidence": [
        {
          "resource": "repo://docs/security/lan-tls-pairing.md#L22-L26",
          "version": "repo-lines-v1:sha256:44f3fa69669af2941e7a4633d8f43a81e0141770beabee9e088e3a39825dc9df:"
