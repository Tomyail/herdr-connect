        }
      ]
    },
    {
      "id": "claim_6c6795f467714323bfb55e1f0f90d18d",
      "statement": "The LAN transport intentionally mirrors Protocol v1's pairing model (stable installation identity + revocable per-device credential) with different primitives: self-signed ECDSA cert fingerprint instead of Ed25519/X25519 identity, bearer tokens instead of keypair grants, and QR one-time secret instead of out-of-band identity exchange — shaping the storage/CLI seams for a future migration, though no forward compatibility is promised and devices may need to re-pair.",
      "evidence": [
        {
          "resource": "repo://docs/security/lan-tls-pairing.md#L80-L99",
          "version": "repo-lines-v1:sha256:8e404aa5931ce487c050bf3ad809af768566ea454b59cc7fb65624c3f0f5f075:"
        }
