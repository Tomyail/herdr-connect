  "claims": [
    {
      "id": "claim_32652b7218d44e2fa39dab54f69414bb",
      "statement": "The daemon's LAN identity is a self-signed ECDSA P-256 certificate (CN 'Herdr Connect LAN', no SANs, 10-year validity) generated on first launch by lanauth.LoadOrCreateCertificate, stored as lan-cert.pem/lan-key.pem next to the database; private key mode 0600. Regenerating the certificate changes the fingerprint and forces all previously paired devices to re-pair.",
      "evidence": [
        {
          "resource": "repo://docs/security/lan-tls-pairing.md#L28-L48",
          "version": "repo-lines-v1:sha256:3c981f3ae12df2e7028edb5ebf91778315f84105ecddda1bd23241f03d7105d8:"
        },
        {
