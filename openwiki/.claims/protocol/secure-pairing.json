          "version": "repo-lines-v1:sha256:351086b093871355fe87d1f7769332291b93cb453831ae653941a32c1098c259:"
        }
      ]
    },
    {
      "id": "claim_0a0f7580ada74699874b85367f310383",
      "statement": "Devices pin the SHA-256 of the leaf certificate DER (base64 RawURL) instead of CA-chain/hostname validation; the fingerprint is returned by POST /v1/pair and advertised in the mDNS 'fp' TXT record. On iOS this requires NSAllowsArbitraryLoads because iOS ATS evaluation runs independently of the URLSessionDelegate and rejects the SAN-less cert on non-local-network paths with -9802.",
      "evidence": [
        {
          "resource": "repo://docs/security/lan-tls-pairing.md#L42-L48",
          "version": "repo-lines-v1:sha256:30682112a3793404fc3ae106128925f7d8e2cc6db9030f435eda21aed9167ab4:"
