    },
    {
      "id": "claim_ca459d51acc341b2964159004b799b13",
      "statement": "The daemon enforces token-bucket rate limits: per-device reads 5 req/s burst 10, per-device writes 1 req/s burst 3, and per-IP 1 req/s burst 20 covering /v1/pair and all unauthenticated/revoked (401) responses; exceeded limits return 429 rate_limited with Retry-After: 1.",
      "evidence": [
        {
          "resource": "repo://internal/demolan/auth.go#L80-L129",
          "version": "repo-lines-v1:sha256:d8bf712a5f8b646428c3435c963b7b5804a19cf1f0a41804696fdca91ddb6313:"
