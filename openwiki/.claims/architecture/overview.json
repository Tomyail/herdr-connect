    {
      "id": "claim_76d74a8e0fd841f3b5fbe1a1ba6d7b74",
      "statement": "The REST handler and the SSE broadcaster share the same cached snapshot function, so enabling SSE does not increase the net Herdr CLI call rate; snapshots use a 1-second TTL cache with singleflight coalescing.",
      "evidence": [
        {
          "resource": "repo://internal/demolan/server.go#L93-L107",
          "version": "repo-lines-v1:sha256:ea4026ae3caf3783fc8b951196d8bb819c2bded91e29242e0072e231fa756124:"
        },
