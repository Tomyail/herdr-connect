        }
      ]
    },
    {
      "id": "claim_37b9c7327f5f40e792058f4df25d902c",
      "statement": "The LAN server enforces token-bucket rate limits: per-device reads 5/s burst 10, per-device writes 1/s burst 3, and per-IP 1/s burst 20 for pairing and unauthenticated requests; exceeding limits yields 429 with rate_limited and Retry-After 1.",
      "evidence": [
        {
          "resource": "repo://internal/demolan/rate_limit.go#L34-L44",
          "version": "repo-lines-v1:sha256:44c16ba015d96d8f072d548121c1dbc077c87b4d5dda730fbbf658612cf754ad:"
        }
      ]
    },
    {
      "id": "claim_4c8f08cf10b24b65bb840acdbd0c7c66",
      "statement": "SSE broadcasting is subscriber-count driven (polls only while subscribers exist) and a per-device stream connection limiter bounds concurrent SSE streams per device.",
      "evidence": [
        {
          "resource": "repo://internal/demolan/server.go#L75-L90",
