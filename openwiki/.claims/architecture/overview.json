  "claims": [
    {
      "id": "claim_cb1d1d5fbda14d02ab434584f475f219",
      "statement": "Herdr Connect follows a three-tier architecture: the Herdr CLI provides raw data, a Go daemon projects it to SQLite and serves it over an HTTPS LAN API on port 9808, and a React Native iOS client discovers, pairs with, and consumes the API; a separate protocol package defines HPKE/Ed25519 primitives for future relay E2EE that are not yet integrated into the LAN transport.",
      "evidence": [
        {
          "resource": "repo://cmd/herdr-connect/main.go",
          "version": "repo-file-v1:sha256:f420e3569abde44756f17814ccca255d6a493bac4a050d88e20f8c94acfa9f77"
        },
        {
          "resource": "repo://internal/demolan/server.go#L20-L31",
          "version": "repo-lines-v1:sha256:09a9a8822a05f53ca310de21e18ecd1664c3dc6d79e75df94970062c6de9679c:"
        }
      ]
    },
    {
      "id": "claim_439b3b62f4524dada08cd369d537a8d9",
      "statement": "cmd/herdr-connect/main.go is a thin entrypoint: it wires a signal-aware context into daemoncli.ExecuteVersion and provides a source factory selecting the real herdr CLI adapter (binary from HERDR_CONNECT_HERDR_PATH, default 'herdr') or an in-process fake source with full capabilities.",
      "evidence": [
        {
          "resource": "repo://cmd/herdr-connect/main.go#L15-L53",
          "version": "repo-lines-v1:sha256:00b6e6e23b036b31fa1408fe9ced424a84eafbe198d6c3f73c6deda6e72bd3fa:"
        }
      ]
    },
    {
      "id": "claim_ab48a0341baa4744a9797677275c3c67",
      "statement": "The daemon advertises a _herdr-connect._tcp Bonjour service including an fp TXT record with the TLS certificate fingerprint, which the mobile client uses for pairing verification and certificate pinning.",
      "evidence": [
        {
          "resource": "repo://internal/demolan/advertiser_darwin.go",
          "version": "repo-file-v1:sha256:d99ae1dc3a627339478ff64d9ecc092734fd433a2e4dc442419e06698035cd84"
