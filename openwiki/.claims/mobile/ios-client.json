    {
      "id": "claim_6239f3932bf94412af3c44a88642b26e",
      "statement": "One ConnectionSession owns the complete connection lifecycle of exactly one paired installation — discovery match via pinned TLS probes, connect, SSE stream preferred with 3-second polling fallback, exponential backoff reconnect, and foreground/background start/stop — driven by the provider via begin/handleServices/handleDiscoveryFailure/pause/stop, with pause retaining state and stop silencing all callbacks.",
      "evidence": [
        {
          "resource": "repo://apps/mobile/src/connection-session.ts#L1-L120",
          "version": "repo-lines-v1:sha256:aa066e095deadb549431ff7ed6c07fac006e01c8f6f1d0abc8d53843f53dd837:"
        }
      ]
    },
    {
      "id": "claim_28185d76fcdc4e9e8e26e286376c931f",
      "statement": "Because the Bonjour library does not expose mDNS TXT records, instance identity is verified only by pinned TLS: selectCandidates orders probe candidates deterministically (verified-target services first, unknown services next in discovery order, foreign-verified excluded) and classifyProbeFailure maps failures to wrong_daemon/unreachable (try next candidate) or terminal (TLS pin passed, surface the error).",
      "evidence": [
        {
          "resource": "repo://apps/mobile/src/discovery-match.ts#L42-L81",
          "version": "repo-lines-v1:sha256:8d183beddff9823387e61a9225d9ca53a5a3dc7408e5eca28ff26ae4ab84fa9e:"
        }
