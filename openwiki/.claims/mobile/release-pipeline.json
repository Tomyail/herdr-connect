    {
      "id": "claim_5bdb880346914435b9ab0a6139c379a8",
      "statement": "The screenshot scene route is Debug-only: App.tsx reads launch options only when __DEV__ is true, and when a scene is active it pins light theme, the launch-arg locale, and a fixed 9:41 time label.",
