          "version": "repo-lines-v1:sha256:911dc1328f1e5c822340926361546301440f7451dfde10c78dff1c978b2c44c7:"
        }
      ]
    },
    {
      "id": "claim_e1f6fc8657014960909213f5edc01661",
      "statement": "The Android workflow validates the tag against ^v[0-9A-Za-z._-]+$, skips the build when all three named assets (herdr-connect-<tag>-android.apk/.aab/-SHA256SUMS) already exist on the release, builds via apps/mobile/scripts/android-release.sh, renames the checksum manifest to avoid clobbering the daemon SHA256SUMS, waits up to 5 minutes for the daemon workflow to create the GitHub Release, then uploads with gh release upload --clobber and always removes the decoded keystore.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/android-release.yml#L145-L193",
          "version": "repo-lines-v1:sha256:f5aa5ede169aa719135a021e6a256ddee97f5ff6272c27be384afcde7e382bd2:"
