    {
      "id": "claim_8595f7f29cff4175b2d63bb16c0e9bf6",
      "statement": "The Android release workflow is manual-dispatch-only because the five release keystore GitHub secrets (ANDROID_KEYSTORE_BASE64, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD, ANDROID_SIGNING_CERT_SHA256) are not yet configured; tag auto-triggering is deliberately disabled and the workflow fails fast if any secret is missing.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/android-release.yml#L106-L132",
          "version": "repo-lines-v1:sha256:637f2cad283f413fdf11e0c9e8c5a93307d4a47a9e2cc8ca3788337d32c0d9ba:"
        },
        {
